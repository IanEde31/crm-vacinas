# Supabase ------------------------------------------------------------
# Project URL — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# anon/public key — Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role (NUNCA expor no client; usar só em Server Actions / Routes / jobs)
SUPABASE_SERVICE_ROLE_KEY=

# APIFY ---------------------------------------------------------------
# Token da API APIFY — apify.com → Settings → Integrations → API token
APIFY_TOKEN=
# Header secreto validado em /api/webhooks/apify antes de processar payload.
# Gere um valor aleatório qualquer (ex: openssl rand -hex 24).
APIFY_WEBHOOK_SECRET=

# App -----------------------------------------------------------------
# URL pública base do app — usada (server-side) para montar o callback do
# webhook APIFY. Em dev: http://localhost:3000 (o webhook não alcança
# localhost; o polling cobre). Em produção: a URL do deploy na Vercel.
APP_URL=http://localhost:3000
